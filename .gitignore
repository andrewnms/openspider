# ── Build artifacts ───────────────────────────────────────────────────────
target/
dist/
**/node_modules/
**/.DS_Store

# Tauri-side build outputs
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/dist/

# Generated icon previews (the source.svg is the canonical artifact)
desktop/src-tauri/icons/source-1024.png
desktop/src-tauri/icons/_preview-*.png

