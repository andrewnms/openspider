*.log
*.tmp
.env
.env.*

# Vault data — never commit a user's actual workspace
brain-vault/
**/brain-vault/
my-vault/
**/my-vault/

# Secrets that might land in the repo by accident
**/.kbrain/credentials.json
**/.kbrain/secrets.json
**/.openspider/credentials.json
**/.openspider/secrets.json

# IDE
.vscode/
.idea/
*.swp
*.swo
